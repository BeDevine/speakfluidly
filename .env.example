# Copy this file to .env and fill in real values.

# Generate a random 32+ character string, e.g. `openssl rand -hex 32`
SESSION_SECRET="replace-this-with-a-long-random-string"

# Database (from your Supabase project's Connect > Prisma tab)
POSTGRES_PRISMA_URL="postgresql://replace-with-real-value"
POSTGRES_URL_NON_POOLING="postgresql://replace-with-real-value"

# Contact form email (Resend) — sign up free at resend.com to get an API key
RESEND_API_KEY="re_your_api_key_here"
CONTACT_TO_EMAIL="you@example.com"
CONTACT_FROM_EMAIL="onboarding@resend.dev"
